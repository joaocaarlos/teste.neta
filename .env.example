# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_USER=capacity
DB_PASS=capacity123
DB_NAME=capacity
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASS=redis123
REDIS_PORT=6379

MINIO_ROOT_USER=capacity
MINIO_ROOT_PASSWORD=capacity123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
JWT_SECRET=troque_isso_em_producao_use_256bits_aleatorio
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=true
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_STORAGE=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=capacity-uploads
S3_ACCESS_KEY_ID=capacity
S3_SECRET_ACCESS_KEY=capacity123
S3_FORCE_PATH_STYLE=true
MAIL_FROM=CapaCity <noreply@capacity.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
LOG_LEVEL=debug
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_CONCURRENCY=3
ERROR_WEBHOOK_URL=
METRICS_TOKEN=
RUN_MIGRATIONS=true
LOGIN_LOCKOUT_MAX=5
LOGIN_LOCKOUT_TTL_SECONDS=900
RATE_LIMIT_MAX=500
DB_POOL_MAX=20
DB_HOST=localhost

# ─── Captcha ─────────────────────────────────────────────────────────────────
CAPTCHA_THRESHOLD=3
HCAPTCHA_SECRET=
RECAPTCHA_SECRET=

# Pagamentos reais (Stripe Checkout)
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl
ALLOW_MANUAL_PAYMENTS=false

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:3001
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── pgAdmin (dev only — rode com: docker compose --profile dev up) ──────────
PGADMIN_EMAIL=admin@capacity.com
PGADMIN_PASS=admin123
PGADMIN_PORT=5050
