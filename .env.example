# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  ⚠️  NUNCA use estes valores em produção.                                   ║
# ║  Copie este arquivo para .env e substitua CHANGE_ME pelos valores reais.    ║
# ║                                                                              ║
# ║  Como gerar segredos seguros:                                                ║
# ║    JWT_SECRET:    openssl rand -base64 48                                    ║
# ║    DB_PASS:       openssl rand -base64 24                                    ║
# ║    REDIS_PASS:    openssl rand -base64 24                                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ════════════════════════════════════════════════════════════════════════════════
# MÍNIMO PARA RODAR LOCALMENTE (docker compose up)
# Defina apenas estas variáveis no seu .env para o primeiro boot:
#
#   JWT_SECRET=<openssl rand -base64 48>
#   DB_PASS=<qualquer senha>
#   REDIS_PASS=<qualquer senha ou deixe vazio>
#
# Todas as outras têm defaults funcionais para desenvolvimento.
# ════════════════════════════════════════════════════════════════════════════════

# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=capacity
DB_NAME=capacity
# ⚠️  Troque antes de qualquer deploy
DB_PASS=CHANGE_ME_LOCAL_ONLY
DB_POOL_MAX=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# ⚠️  Troque antes de qualquer deploy (deixe vazio para desabilitar auth local)
REDIS_PASS=CHANGE_ME_LOCAL_ONLY

# ─── MinIO (storage local) ────────────────────────────────────────────────────
MINIO_ROOT_USER=capacity
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_ONLY
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ⚠️  Mínimo 32 caracteres — OBRIGATÓRIO trocar em produção
# Gerar: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_256_BIT_SECRET
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

REQUIRE_EMAIL_VERIFICATION=true
RUN_MIGRATIONS=true

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_STORAGE=disk
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# ─── S3 / MinIO (usado quando UPLOAD_STORAGE=s3) ─────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=capacity-uploads
S3_ACCESS_KEY_ID=capacity
S3_SECRET_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
S3_FORCE_PATH_STYLE=true

# ─── E-mail ───────────────────────────────────────────────────────────────────
MAIL_FROM=CapaCity <noreply@capacity.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_CONCURRENCY=3

# ─── Pagamentos ───────────────────────────────────────────────────────────────
# Em desenvolvimento, use manual. Em produção, use stripe.
PAYMENTS_PROVIDER=manual
ALLOW_MANUAL_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl

# ─── Documentação da API ──────────────────────────────────────────────────────
# Em produção, /docs retorna 403 por padrão. Setar true apenas para emergências.
ENABLE_API_DOCS=false

# ─── Observabilidade ──────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
ERROR_WEBHOOK_URL=
# ⚠️  Troque em produção — protege o endpoint /metrics
METRICS_TOKEN=CHANGE_ME_LOCAL_ONLY

# ─── Segurança ────────────────────────────────────────────────────────────────
LOGIN_LOCKOUT_MAX=5
LOGIN_LOCKOUT_TTL_SECONDS=900
RATE_LIMIT_MAX=500
CAPTCHA_THRESHOLD=3
HCAPTCHA_SECRET=
RECAPTCHA_SECRET=

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:3001
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── pgAdmin (dev only — rode com: docker compose --profile dev up) ──────────
PGADMIN_EMAIL=admin@capacity.com
# ⚠️  Troque antes de qualquer deploy
PGADMIN_PASS=CHANGE_ME_LOCAL_ONLY
PGADMIN_PORT=5050

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
